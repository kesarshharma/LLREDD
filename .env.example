# LEREDD System Environment Configuration (.env.example)
# Copy to .env for local overrides. NEVER commit real API keys or secrets.

# --- LLM Backend Settings ---
LLM_PROVIDER=mock                  # Options: mock, openai, ollama, gemini
LLM_MODEL=gpt-4                    # Fixed model identifier (e.g., gpt-4, llama3, gemini-2.5-flash)
TEMPERATURE=0.2                    # Sampling temperature [0.0, 1.0]
OPENAI_API_KEY=                    # Leave blank unless calling OpenAI
GEMINI_API_KEY=                    # Leave blank unless calling Google Gemini
OLLAMA_BASE_URL=http://localhost:11434

# --- Confidence Screening (Part 4) ---
# Self-reported Likert score (0-5) is an ordinal screening cue, NOT calibrated probability.
# Predictions with score <= CONFIDENCE_THRESHOLD keep their predicted class and are routed
# with validation_status=requires_review. Set -1 to disable screening.
CONFIDENCE_THRESHOLD=4
LEGACY_REWRITE_LOW_CONFIDENCE_TO_NO_DEPENDENCY=false

# --- Example Retrieval & Metadata-Aware Hybrid RRF (Part 6) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_METRIC=euclidean        # Options: euclidean, cosine
AGGREGATION=average                # Options: average (Paper Eq. 1), max (Paper Eq. 2)
K_EXAMPLES=6                       # Dynamic ICL examples per dependency category [0..10]
RETRIEVAL_MODE=dense               # Options: dense, bm25, hybrid, hybrid_no_metadata, hybrid_metadata
RRF_K=60                           # Reciprocal Rank Fusion constant (>= 1)
DENSE_WEIGHT=1.0                   # Hybrid RRF weight for SBERT dense ranker (>= 0.0)
BM25_WEIGHT=1.0                    # Hybrid RRF weight for BM25Plus lexical ranker (>= 0.0)
METADATA_WEIGHT=1.0                # Hybrid RRF weight for structured metadata overlap (0.0 disables)

# --- SRS Context Selection / RAG (Part 7) ---
USE_RAG=false
RAG_CHUNK_SIZE=1000                # Max characters per chunk (> 0)
RAG_CHUNK_OVERLAP=200              # Overlap characters [0, RAG_CHUNK_SIZE)
RAG_K_CHUNKS=6                     # Top-k context chunks injected into prompt
RAG_CHUNKING_MODE=fixed            # Options: fixed, requirement_boundary
RAG_DEDUPLICATE_CHUNKS=false       # Filter exact and near-duplicate chunks before ranking
RAG_NEAR_DUPLICATE_THRESHOLD=0.90  # Token Jaccard cutoff (0.0, 1.0] for near-duplicate detection
RAG_CITE_ID_BOOST=0.0              # Additive score boost for chunks mentioning cited requirement IDs
RAG_MIN_SIMILARITY=0.10            # Diagnostic floor flagging low-relevance retrieved chunks

# --- Storage & Caching ---
DATA_DIR=data
CACHE_DIR=data/embeddings
